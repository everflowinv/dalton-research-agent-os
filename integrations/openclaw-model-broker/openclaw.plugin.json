{
  "id": "dalton-openclaw-model-broker",
  "name": "Dalton OpenClaw Model Broker",
  "description": "Host-owned model completion bridge for an external Dalton runtime.",
  "version": "0.1.0-spike.3",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["dedicatedAgentId", "clientId", "profiles"],
    "properties": {
      "dedicatedAgentId": {
        "type": "string",
        "minLength": 1
      },
      "clientId": {
        "type": "string",
        "pattern": "^client:[A-Za-z0-9._-]+$"
      },
      "socketName": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+\\.sock$",
        "default": "dalton-model-broker.sock"
      },
      "profiles": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "model", "maxTokens", "timeoutMs"],
          "properties": {
            "id": {"type": "string", "pattern": "^profile:[A-Za-z0-9._-]+$"},
            "model": {"type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
            "maxTokens": {"type": "integer", "minimum": 1},
            "timeoutMs": {"type": "integer", "minimum": 1},
            "providerControls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "rateCard"],
              "properties": {
                "mode": {"const": "openai-responses-input-count-v1"},
                "rateCard": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "model", "serviceTier", "inputUsdPerMillion",
                    "cachedInputUsdPerMillion", "cacheWriteUsdPerMillion",
                    "outputUsdPerMillion", "verifiedAt", "expiresAt"
                  ],
                  "properties": {
                    "model": {"type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
                    "serviceTier": {"const": "default"},
                    "inputUsdPerMillion": {"type": "string", "pattern": "^(?:0\\.(?:0*[1-9][0-9]*)|[1-9][0-9]*(?:\\.[0-9]+)?)$"},
                    "cachedInputUsdPerMillion": {"type": "string", "pattern": "^(?:0\\.(?:0*[1-9][0-9]*)|[1-9][0-9]*(?:\\.[0-9]+)?)$"},
                    "cacheWriteUsdPerMillion": {"type": "string", "pattern": "^(?:0\\.(?:0*[1-9][0-9]*)|[1-9][0-9]*(?:\\.[0-9]+)?)$"},
                    "outputUsdPerMillion": {"type": "string", "pattern": "^(?:0\\.(?:0*[1-9][0-9]*)|[1-9][0-9]*(?:\\.[0-9]+)?)$"},
                    "verifiedAt": {"type": "string", "format": "date-time"},
                    "expiresAt": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          }
        }
      },
      "maxFrameBytes": {"type": "integer", "minimum": 1024, "maximum": 1048576, "default": 262144},
      "maxOutputBytes": {"type": "integer", "minimum": 1, "maximum": 1048576, "default": 262144},
      "maxConcurrent": {"type": "integer", "minimum": 1, "maximum": 32, "default": 2},
      "idleTimeoutMs": {"type": "integer", "minimum": 100, "maximum": 60000, "default": 5000},
      "authMaxSkewMs": {"type": "integer", "minimum": 1000, "maximum": 300000, "default": 30000},
      "journalTtlMs": {"type": "integer", "minimum": 60000, "maximum": 604800000, "default": 86400000},
      "journalMaxRecords": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 1000},
      "journalMaxBytes": {"type": "integer", "minimum": 4096, "maximum": 67108864, "default": 8388608}
    }
  }
}
