            "prime_revenue": "=paid_members*ARPPU",
            "annual_from_quarters": "=SUM(Q1:Q4)",
            "quarterly_forecast": "=prior_comparable_quarter*(1+growth_assumption)"
          }
        },
        "Financials - AMZN": {
          "role": "annual and quarterly statements linked to drivers",
          "sections": [
            "income statement", "non-GAAP measures", "segment breakdown",
            "cash flow statement", "balance sheet", "property and capex",
            "consensus and earnings history"
          ],
          "formula_templates": {
            "revenue": "=retail_and_subscription+AWS",
            "operating_income": "=gross_profit+fulfillment+other_opex",
            "net_income": "=pretax_income+tax+equity_method_activity",
            "free_cash_flow": "=operating_cash_flow+capex",
            "balance_check": "=assets-liabilities-equity"
          }
        },
        "Valuation - AMZN": {
          "role": "market data, consensus comparison, SOTP and target price",
          "sections": ["market bridge", "forecast comparison", "multiples", "SOTP"],
          "formula_templates": {
            "enterprise_value": "=market_cap+minority_interest+debt-cash",
            "retail_value": "=retail_metric*retail_multiple",
            "aws_value": "=AWS_NOPAT*AWS_PE",
            "equity_value": "=SUM(segment_values)*(1-holdco_discount)",
            "target_price": "=equity_value/diluted_shares",
            "discounted_target": "=future_target/(1+required_return)^year_fraction"
          }
        },
        "Category Analysis - AMZN": {
          "role": "monthly external category dataset with mix and growth calculations"
        }
