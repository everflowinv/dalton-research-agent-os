{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverageManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "loop_version_ref", "loop_version_hash", "through_round", "entries", "required_coverage_items", "coverage_complete", "negative_candidate_eligible", "derivation_kind", "actor_ref", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^coverage-manifest:[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "loop_version_ref": {"type": "string", "minLength": 1},
    "loop_version_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "through_round": {"type": "integer", "minimum": 1},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "required_coverage_items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "coverage_complete": {"type": "boolean"},
    "negative_candidate_eligible": {"type": "boolean"},
    "derivation_kind": {"const": "core_from_exact_result_envelopes"},
    "actor_ref": {"const": "core:bounded-planner-coverage"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage_item_ref", "round_ref", "template_version_ref", "template_version_hash", "source_ref", "locator", "query_terms", "observation_status", "match_count", "matched_source_locations", "result_envelope_ref", "result_envelope_hash"],
      "properties": {
        "coverage_item_ref": {"type": "string", "minLength": 1},
        "round_ref": {"type": "string", "minLength": 1},
        "template_version_ref": {"type": "string", "minLength": 1},
        "template_version_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_ref": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "query_terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observation_status": {"enum": ["observed", "not_found_in_scope", "source_unavailable"]},
        "match_count": {"type": "integer", "minimum": 0},
        "matched_source_locations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "result_envelope_ref": {"type": "string", "minLength": 1},
        "result_envelope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
