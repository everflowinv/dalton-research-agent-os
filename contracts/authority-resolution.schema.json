{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dalton://contracts/authority-resolution.schema.json",
  "title": "Dalton Connector AuthorityResolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "created_at", "source_envelope_ref", "source_envelope_hash",
    "artifact_ref", "artifact_hash", "source_ref", "operation", "execution_ref", "execution_hash",
    "connector_invocation_ref", "connector_invocation_hash", "connector_profile_ref", "connector_profile_hash",
    "call_spec_ref", "call_spec_hash", "work_order_ref", "work_order_hash", "result_envelope_ref", "result_envelope_hash",
    "scheduler_attempt_number", "physical_attempt_refs", "result_physical_attempt_ref", "reservation_ref", "reservation_hash",
    "usage_ref", "usage_hash", "cost_ref", "cost_hash", "settlement_ref", "settlement_hash",
    "checkpoint_ref", "checkpoint_hash", "plan_ref", "plan_hash", "context_pack_ref", "context_pack_hash",
    "step_ref", "step_hash", "runner_request_ref", "runner_request_hash", "actual_runner_request_ref", "actual_runner_request_hash", "receipt_ref", "receipt_hash",
    "source_record_refs", "raw_response_hash", "source_schema_hash", "source_content_hash",
    "published_at", "updated_at", "as_of", "retrieved_at", "completeness", "status",
    "access_policy_ref", "retention_policy_ref", "terms_policy_ref", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_envelope_ref": {"type": "string", "minLength": 1},
    "artifact_ref": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "execution_ref": {"type": "string", "minLength": 1},
    "connector_invocation_ref": {"type": "string", "minLength": 1},
    "connector_profile_ref": {"type": "string", "minLength": 1},
    "call_spec_ref": {"type": "string", "minLength": 1},
    "work_order_ref": {"type": "string", "minLength": 1},
    "result_envelope_ref": {"type": "string", "minLength": 1},
    "result_physical_attempt_ref": {"type": "string", "minLength": 1},
    "reservation_ref": {"type": "string", "minLength": 1},
    "usage_ref": {"type": "string", "minLength": 1},
    "cost_ref": {"type": "string", "minLength": 1},
    "settlement_ref": {"type": "string", "minLength": 1},
    "checkpoint_ref": {"type": "string", "minLength": 1},
    "plan_ref": {"type": "string", "minLength": 1},
    "context_pack_ref": {"type": "string", "minLength": 1},
    "step_ref": {"type": "string", "minLength": 1},
    "runner_request_ref": {"type": "string", "minLength": 1},
    "actual_runner_request_ref": {"type": "string", "minLength": 1},
    "receipt_ref": {"type": "string", "minLength": 1},
    "source_record_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "physical_attempt_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scheduler_attempt_number": {"type": "integer", "minimum": 1},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "as_of": {"type": ["string", "null"], "format": "date-time"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "completeness": {"enum": ["enumerated", "ranked", "partial", "unknown"]},
    "status": {"enum": ["complete", "partial", "empty", "error"]},
    "access_policy_ref": {"type": "string", "minLength": 1},
    "retention_policy_ref": {"type": "string", "minLength": 1},
    "terms_policy_ref": {"type": "string", "minLength": 1},
    "source_envelope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "connector_invocation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "connector_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "call_spec_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "work_order_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_envelope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reservation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "usage_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cost_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "settlement_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_pack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "step_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runner_request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actual_runner_request_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_response_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
