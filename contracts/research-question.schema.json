{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ResearchQuestion","type":"object","additionalProperties":false,"required":["schema_version","id","created_at","question_ref","version","prior_version_ref","company_ref","question","answer_criteria","state","defer_until","wake_condition","source_refs","actor_ref","content_hash"],"properties":{"schema_version":{"const":"0.1"},"id":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"question_ref":{"type":"string","minLength":1},"version":{"type":"integer","minimum":1},"prior_version_ref":{"type":["string","null"]},"company_ref":{"type":"string","minLength":1},"question":{"type":"string","minLength":1},"answer_criteria":{"type":"string","minLength":1},"state":{"enum":["open","selected","deferred","dormant"]},"defer_until":{"type":["string","null"]},"wake_condition":{"type":["string","null"]},"source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"actor_ref":{"type":"string","minLength":1},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
