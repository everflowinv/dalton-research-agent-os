{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalton.local/schemas/usage-entry.schema.json",
  "title": "UsageEntry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "invocation_ref", "work_order_ref", "workflow_ref", "revision", "occurred_at", "provider", "model", "model_family", "profile_ref", "runtime_ref", "capability", "granularity", "input_tokens", "output_tokens", "reasoning_tokens", "cache_read_tokens", "cache_write_tokens", "total_tokens", "requests", "duration_ms", "input_bytes", "output_bytes", "raw_usage", "provider_usage_ref", "metering_source", "measurement_status", "correction_of_ref", "actor_ref", "content_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "invocation_ref": {"type": "string", "minLength": 1},
    "work_order_ref": {"type": "string", "minLength": 1},
    "workflow_ref": {"type": ["string", "null"], "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "model_family": {"type": "string", "minLength": 1},
    "profile_ref": {"type": "string", "minLength": 1},
    "runtime_ref": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "granularity": {"type": "string", "minLength": 1},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0},
    "total_tokens": {"type": ["integer", "null"], "minimum": 0},
    "requests": {"type": ["integer", "null"], "minimum": 0},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "input_bytes": {"type": ["integer", "null"], "minimum": 0},
    "output_bytes": {"type": ["integer", "null"], "minimum": 0},
    "raw_usage": {"type": "object"},
    "provider_usage_ref": {"type": ["string", "null"], "minLength": 1},
    "metering_source": {"type": "string", "enum": ["provider_reported", "launcher_measured", "worker_reported", "estimated"]},
    "measurement_status": {"type": "string", "enum": ["final", "partial", "estimated", "unavailable"]},
    "correction_of_ref": {"type": ["string", "null"], "minLength": 1},
    "actor_ref": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
