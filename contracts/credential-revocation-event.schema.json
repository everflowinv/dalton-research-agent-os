{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalton.local/schemas/credential-revocation-event.schema.json",
  "title": "CredentialRevocationEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "created_at", "grant_ref", "grant_hash",
    "reason_code", "actor_ref", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"$ref": "#/$defs/ref"},
    "created_at": {"type": "string", "format": "date-time"},
    "grant_ref": {"$ref": "#/$defs/ref"},
    "grant_hash": {"$ref": "#/$defs/hash"},
    "reason_code": {
      "enum": ["manual", "rotation", "permission_change", "security_incident", "source_disabled"]
    },
    "actor_ref": {"$ref": "#/$defs/ref"},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+._-]*:[A-Za-z0-9][A-Za-z0-9:._-]*$",
      "not": {"pattern": "^(file|path|https?):"}
    }
  }
}
