{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntentContextPack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "surface", "bindings", "focused_target", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "surface": {"const": "dalton_cockpit"},
    "bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/binding"}
    },
    "focused_target": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/binding"}
      ]
    },
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "hash", "label", "state", "authority", "parent_ref", "allowed_intents"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "label": {"type": "string", "minLength": 1},
        "state": {"type": "string", "minLength": 1},
        "authority": {"type": "boolean"},
        "parent_ref": {"type": ["string", "null"]},
        "allowed_intents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["question", "directive", "priority", "doctrine_or_driver_revision", "correction", "approval", "mandate_budget_permission", "meta"]
          }
        }
      }
    }
  }
}
