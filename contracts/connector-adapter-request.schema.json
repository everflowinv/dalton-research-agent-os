{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectorAdapterRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "runner_request_ref", "runner_request_hash",
    "connector_invocation_ref", "profile_ref", "profile_hash", "call_spec_ref",
    "call_spec_hash", "reservation_ref", "reservation_hash", "physical_attempt_number",
    "source_identity", "source_hash", "adapter_ref", "adapter_hash", "resolver_ref",
    "resolver_manifest_hash", "operation", "parameters", "query_hash", "input_schema_ref",
    "input_schema_hash", "output_schema_ref", "output_schema_hash", "allowed_hosts",
    "network_policy", "credential_grant_ref", "deadline_at", "max_response_bytes",
    "max_records", "raw_sink_ref", "content_hash"
  ],
  "properties": {
    "protocol_version": {"const": "0.1"},
    "runner_request_ref": {"type": "string", "minLength": 1},
    "runner_request_hash": {"$ref": "#/$defs/hash"},
    "connector_invocation_ref": {"type": "string", "minLength": 1},
    "profile_ref": {"type": "string", "minLength": 1},
    "profile_hash": {"$ref": "#/$defs/hash"},
    "call_spec_ref": {"type": "string", "minLength": 1},
    "call_spec_hash": {"$ref": "#/$defs/hash"},
    "reservation_ref": {"type": "string", "minLength": 1},
    "reservation_hash": {"$ref": "#/$defs/hash"},
    "physical_attempt_number": {"type": "integer", "minimum": 1},
    "source_identity": {"$ref": "#/$defs/source_identity"},
    "source_hash": {"$ref": "#/$defs/hash"},
    "adapter_ref": {"type": "string", "minLength": 1},
    "adapter_hash": {"$ref": "#/$defs/hash"},
    "resolver_ref": {"type": "string", "minLength": 1},
    "resolver_manifest_hash": {"$ref": "#/$defs/hash"},
    "operation": {"type": "string", "minLength": 1},
    "parameters": {"type": "object"},
    "query_hash": {"$ref": "#/$defs/hash"},
    "input_schema_ref": {"type": "string", "minLength": 1},
    "input_schema_hash": {"$ref": "#/$defs/hash"},
    "output_schema_ref": {"type": "string", "minLength": 1},
    "output_schema_hash": {"$ref": "#/$defs/hash"},
    "allowed_hosts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "network_policy": {"$ref": "#/$defs/network_policy"},
    "credential_grant_ref": {"const": null},
    "deadline_at": {"type": "string", "format": "date-time"},
    "max_response_bytes": {"type": "integer", "minimum": 1},
    "max_records": {"type": "integer", "minimum": 1},
    "raw_sink_ref": {"type": "string", "pattern": "^raw-sink:[0-9a-f]{64}$"},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "source_type", "source_version"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "source_type": {
          "enum": [
            "official_filing", "authenticated_library", "social_enumeration",
            "social_search", "public_web", "market_data"
          ]
        },
        "source_version": {"type": "string", "minLength": 1}
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_schemes", "allow_redirects", "max_redirects", "resolve_public_only"],
      "properties": {
        "allowed_schemes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"const": "https"}
        },
        "allow_redirects": {"type": "boolean"},
        "max_redirects": {"type": "integer", "minimum": 0},
        "resolve_public_only": {"const": true}
      },
      "allOf": [
        {
          "if": {
            "properties": {"allow_redirects": {"const": false}},
            "required": ["allow_redirects"]
          },
          "then": {"properties": {"max_redirects": {"const": 0}}}
        }
      ]
    }
  }
}
