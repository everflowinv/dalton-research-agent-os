{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dalton/compiled-connector-plan/0.1",
  "title": "CompiledConnectorPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "task_ref", "task_hash", "planner_ref", "planner_hash", "routing_policy_ref", "routing_policy_hash", "steps", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "task_ref": {"type": "string", "minLength": 1},
    "task_hash": {"$ref": "#/$defs/hash"},
    "planner_ref": {"type": "string", "minLength": 1},
    "planner_hash": {"$ref": "#/$defs/hash"},
    "routing_policy_ref": {"type": "string", "minLength": 1},
    "routing_policy_hash": {"$ref": "#/$defs/hash"},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "source_ref", "source_hash", "connector_profile_ref", "connector_profile_hash", "operation", "parameters", "query_hash", "input_schema_ref", "input_schema_hash", "output_schema_ref", "output_schema_hash", "completeness_required", "depends_on", "fallback_step_refs", "max_attempts", "content_hash"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "source_hash": {"$ref": "#/$defs/hash"},
        "connector_profile_ref": {"type": "string", "minLength": 1},
        "connector_profile_hash": {"$ref": "#/$defs/hash"},
        "operation": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "query_hash": {"$ref": "#/$defs/hash"},
        "input_schema_ref": {"type": "string", "minLength": 1},
        "input_schema_hash": {"$ref": "#/$defs/hash"},
        "output_schema_ref": {"type": "string", "minLength": 1},
        "output_schema_hash": {"$ref": "#/$defs/hash"},
        "completeness_required": {"enum": ["enumerated", "ranked", "partial_allowed"]},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fallback_step_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
