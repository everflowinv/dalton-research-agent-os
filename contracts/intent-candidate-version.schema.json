{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntentCandidateVersion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "utterance_version_ref", "utterance_version_hash", "attempt_ref", "attempt_hash", "candidate", "risk_level", "requires_confirmation", "candidate_only", "executable", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "utterance_version_ref": {"type": "string", "minLength": 1},
    "utterance_version_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt_ref": {"type": "string", "minLength": 1},
    "attempt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "intent_kind", "disposition", "effect", "clarification_question", "evidence_spans", "rationale"],
      "properties": {
        "schema_version": {"const": "0.1"},
        "intent_kind": {"enum": ["question", "directive", "priority", "doctrine_or_driver_revision", "correction", "approval", "mandate_budget_permission", "meta"]},
        "disposition": {"enum": ["candidate", "clarification_required", "unsupported"]},
        "effect": {"type": ["object", "null"]},
        "clarification_question": {"type": ["string", "null"]},
        "evidence_spans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 1}
            }
          }
        },
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "risk_level": {"enum": ["low", "high"]},
    "requires_confirmation": {"type": "boolean"},
    "candidate_only": {"const": true},
    "executable": {"const": false},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
