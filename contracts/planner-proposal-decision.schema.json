{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlannerProposalDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "proposal_ref", "proposal_hash", "decision", "reason", "actor_ref", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^planner-proposal-decision:[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "proposal_ref": {"type": "string", "minLength": 1},
    "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["accepted", "rejected"]},
    "reason": {"type": "string", "minLength": 1},
    "actor_ref": {"const": "core:bounded-planner-admission"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
