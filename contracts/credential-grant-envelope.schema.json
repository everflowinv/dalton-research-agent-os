{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalton.local/schemas/credential-grant-envelope.schema.json",
  "title": "CredentialGrantEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "created_at", "expires_at", "authority_ref",
    "grant_kind", "target_ref", "connector_profile_ref", "connector_profile_hash",
    "capability_lease_ref", "capability_lease_hash", "adapter_ref", "adapter_hash",
    "principal_ref", "credential_slot_refs", "allowed_operations", "max_calls",
    "content_hash"
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+._-]*:[A-Za-z0-9][A-Za-z0-9:._-]*$",
      "not": {"pattern": "^(file|path|https?):"}
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"$ref": "#/$defs/ref"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authority_ref": {"$ref": "#/$defs/ref"},
    "grant_kind": {"enum": ["mcp_managed", "https_credential"]},
    "target_ref": {"$ref": "#/$defs/ref"},
    "connector_profile_ref": {"$ref": "#/$defs/ref"},
    "connector_profile_hash": {"$ref": "#/$defs/hash"},
    "capability_lease_ref": {"$ref": "#/$defs/ref"},
    "capability_lease_hash": {"$ref": "#/$defs/hash"},
    "adapter_ref": {"$ref": "#/$defs/ref"},
    "adapter_hash": {"$ref": "#/$defs/hash"},
    "principal_ref": {"$ref": "#/$defs/ref"},
    "credential_slot_refs": {
      "allOf": [
        {"$ref": "#/$defs/refs"},
        {
          "items": {
            "type": "string",
            "pattern": "^credential[-_]slot:[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          }
        }
      ]
    },
    "allowed_operations": {
      "allOf": [
        {"$ref": "#/$defs/refs"},
        {
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
          }
        }
      ]
    },
    "max_calls": {"type": "integer", "minimum": 1},
    "content_hash": {"$ref": "#/$defs/hash"}
  }
}
