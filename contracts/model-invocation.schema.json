{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalton.local/schemas/model-invocation.schema.json",
  "title": "ModelInvocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "work_order_ref", "profile_ref", "granularity", "capability", "provider", "model", "model_family", "input_refs", "output_refs", "started_at", "completed_at", "usage", "side_effects", "runtime_ref", "actor_ref"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "work_order_ref": {"type": "string", "minLength": 1},
    "profile_ref": {"type": "string", "minLength": 1},
    "granularity": {"type": "string", "enum": ["work_order", "task", "verification", "adjudication", "system"]},
    "capability": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "model_family": {"type": "string", "minLength": 1},
    "input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "output_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": ["string", "null"]},
    "usage": {"type": "object"},
    "side_effects": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "runtime_ref": {"type": "string", "minLength": 1},
    "actor_ref": {"type": "string", "minLength": 1},
    "parent_ref": {"type": ["string", "null"]},
    "environment_hash": {"type": ["string", "null"]}
  }
}
