{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"ConnectorIncidentEvent","type":"object","additionalProperties":false,
  "required":["schema_version","id","created_at","incident_ref","state","prior_event_ref","actor_ref","content_hash"],
  "properties":{"schema_version":{"const":"0.1"},"id":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"incident_ref":{"type":"string","minLength":1},"state":{"enum":["opened","resolved"]},"prior_event_ref":{"type":["string","null"]},"actor_ref":{"type":"string","minLength":1},"content_hash":{"$ref":"#/$defs/hash"}},
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
