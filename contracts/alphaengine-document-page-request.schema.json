{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaEngineDocumentPageRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "created_at", "plan_ref", "plan_hash",
    "document_ref", "page_ordinal", "request_cursor", "expected_offset",
    "max_response_bytes", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^alphaengine-document-page:"},
    "created_at": {"type": "string", "format": "date-time"},
    "plan_ref": {"type": "string", "pattern": "^alphaengine-document-plan:"},
    "plan_hash": {"$ref": "#/$defs/hash"},
    "document_ref": {"type": "string", "pattern": "^alphaengine-doc:[A-Za-z0-9._-]{1,128}$"},
    "page_ordinal": {"type": "integer", "minimum": 1, "maximum": 20},
    "request_cursor": {"type": ["string", "null"], "pattern": "^[0-9]+$"},
    "expected_offset": {"type": "integer", "minimum": 0},
    "max_response_bytes": {"type": "integer", "minimum": 1},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
