{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalton.local/schemas/thesis-version-v0.3.schema.json",
  "title": "ThesisVersionV0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "created_at",
    "thesis_ref",
    "version",
    "statement",
    "mechanism",
    "confidence",
    "implied_expectation",
    "claim_refs",
    "catalyst_refs",
    "falsifier_refs",
    "change_reason",
    "prior_version_ref",
    "authority_kind",
    "authority_ref",
    "committed_by_ref",
    "content_hash",
    "question_ref",
    "stance",
    "proposition_direction",
    "view_status",
    "falsification_conditions",
    "passage_refs",
    "framework_version_ref",
    "disagreement"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "thesis_ref": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "implied_expectation": {
      "type": "string",
      "minLength": 1
    },
    "claim_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "catalyst_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "falsifier_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "change_reason": {
      "type": "string",
      "minLength": 1
    },
    "prior_version_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_kind": {
      "enum": [
        "verification",
        "human_admission"
      ]
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "committed_by_ref": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "minLength": 1
    },
    "question_ref": {
      "type": "string",
      "pattern": "^question:.+"
    },
    "stance": {
      "enum": [
        "house",
        "counter"
      ]
    },
    "proposition_direction": {
      "enum": [
        "supports",
        "contradicts",
        "uncertain"
      ]
    },
    "view_status": {
      "enum": [
        "active",
        "broken"
      ]
    },
    "falsification_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_ref",
          "operator",
          "threshold",
          "unit",
          "deadline",
          "evidence_refs"
        ],
        "properties": {
          "metric_ref": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "lt",
              "lte",
              "gt",
              "gte",
              "eq"
            ]
          },
          "threshold": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^-?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$"
              }
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "deadline": {
            "type": "string",
            "format": "date"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    "passage_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^doc-passage:.+"
      }
    },
    "framework_version_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "disagreement": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "other_thesis_version_ref",
        "other_thesis_hash",
        "reason",
        "evidence_refs",
        "deadline",
        "arbiter_ref"
      ],
      "properties": {
        "other_thesis_version_ref": {
          "type": "string",
          "minLength": 1
        },
        "other_thesis_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "deadline": {
          "type": "string",
          "format": "date"
        },
        "arbiter_ref": {
          "type": "string",
          "pattern": "^human:.+"
        }
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "claim_refs": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "passage_refs": {
          "minItems": 1
        }
      }
    }
  ]
}
