{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ResearchQuestionSelectionLink","type":"object","additionalProperties":false,"required":["schema_version","id","created_at","question_ref","decision_ref","decision_hash","cycle_ref","cycle_hash","candidate_ref","event_ref","actor_ref","content_hash"],"properties":{"schema_version":{"const":"0.1"},"id":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"question_ref":{"type":"string","pattern":"^research-question:[0-9a-f]{32}$"},"decision_ref":{"type":"string","minLength":1},"decision_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"cycle_ref":{"type":"string","minLength":1},"cycle_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"candidate_ref":{"type":"string","minLength":1},"event_ref":{"type":"string","minLength":1},"actor_ref":{"type":"string","minLength":1},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
