{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"dalton/numeric-verification-spec/0.1","title":"NumericVerificationSpec","type":"object","additionalProperties":false,
  "required":["schema_version","id","created_at","operator","inputs","output_value","output_unit","output_currency","output_scale","output_period","rounding","content_hash"],
  "properties":{"schema_version":{"const":"0.1"},"id":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"operator":{"enum":["identity","sum","difference","ratio","growth_percentage"]},"inputs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/input"}},"output_value":{"$ref":"#/$defs/decimal"},"output_unit":{"type":"string","minLength":1},"output_currency":{"anyOf":[{"type":"string","pattern":"^[A-Z]{3}$"},{"type":"null"}]},"output_scale":{"type":"string","minLength":1},"output_period":{"$ref":"#/$defs/period"},"rounding":{"type":"object","additionalProperties":false,"required":["mode","digits"],"properties":{"mode":{"enum":["half_up","half_even","half_down","up","down","ceiling","floor"]},"digits":{"type":"integer","minimum":0,"maximum":18}}},"content_hash":{"$ref":"#/$defs/hash"}},
