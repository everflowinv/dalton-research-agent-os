{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "ResearchPlanApproval", "type": "object", "additionalProperties": false, "required": ["schema_version", "id", "created_at", "plan_version_ref", "plan_version_hash", "decision", "reason", "actor_ref", "content_hash"], "properties": {"schema_version": {"const": "0.1"}, "id": {"type": "string", "pattern": "^research-plan-approval:[0-9a-f]{32}$"}, "created_at": {"type": "string", "format": "date-time"}, "plan_version_ref": {"type": "string", "pattern": "^research-plan:[0-9a-f]{32}$"}, "plan_version_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "decision": {"enum": ["accepted", "rejected"]}, "reason": {"type": "string", "minLength": 1}, "actor_ref": {"type": "string", "pattern": "^human:[A-Za-z0-9._-]+$"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}