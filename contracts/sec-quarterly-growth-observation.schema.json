{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"dalton/sec-quarterly-growth-observation/0.1",
  "title":"SecQuarterlyGrowthObservation",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","id","created_at","source_ref","operation","entity_name","cik","taxonomy","concept_candidates","eligible_concepts","concept","label","unit","form","filed_from","filed_to","latest_accession","selection_basis","current","prior","growth_percent","normalized_statement","source_record_refs","provider_request_ref","raw_sha256","content_hash"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "id":{"type":"string","minLength":1},
    "created_at":{"type":"string","format":"date-time"},
    "source_ref":{"const":"source:sec-edgar"},
    "operation":{"const":"get_company_facts"},
    "entity_name":{"type":"string","minLength":1},
    "cik":{"type":"string","pattern":"^[0-9]{10}$"},
    "taxonomy":{"const":"us-gaap"},
    "concept_candidates":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9]{0,127}$"}},
    "eligible_concepts":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9]{0,127}$"}},
    "concept":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9]{0,127}$"},
    "label":{"type":"string","minLength":1},
    "unit":{"const":"USD"},
    "form":{"const":"10-Q"},
    "filed_from":{"type":"string","format":"date"},
    "filed_to":{"type":"string","format":"date"},
    "latest_accession":{"type":"string","pattern":"^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
    "selection_basis":{"const":"ordered_allowlist_latest_10-Q"},
    "current":{"$ref":"#/$defs/fact"},
    "prior":{"$ref":"#/$defs/fact"},
    "growth_percent":{"$ref":"#/$defs/decimal"},
    "normalized_statement":{"type":"string","minLength":1},
    "source_record_refs":{"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "provider_request_ref":{"type":"string","minLength":1},
    "raw_sha256":{"$ref":"#/$defs/hash"},
    "content_hash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "decimal":{"type":"string","pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "fact":{
      "type":"object",
      "additionalProperties":false,
      "required":["accession","start","end","filed","fy","fp","form","frame","value","record_hash"],
      "properties":{
        "accession":{"type":"string","pattern":"^[0-9]{10}-[0-9]{2}-[0-9]{6}$"},
        "start":{"type":"string","format":"date"},
        "end":{"type":"string","format":"date"},
        "filed":{"type":"string","format":"date"},
        "fy":{"type":"integer","minimum":1900,"maximum":2200},
        "fp":{"type":"string","minLength":1},
        "form":{"const":"10-Q"},
        "frame":{"type":"string","pattern":"^CY[0-9]{4}Q[1-4]$"},
        "value":{"$ref":"#/$defs/decimal"},
        "record_hash":{"$ref":"#/$defs/hash"}
      }
    }
  }
}
