{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundedPlannerLoopVersion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "loop_ref", "version", "prior_version_ref", "question_ref", "question_version_ref", "question_version_hash", "planner_ref", "planner_hash", "template_bindings", "required_coverage_items", "budget", "doctrine_binding", "actor_ref", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^bounded-planner-loop-version:[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "loop_ref": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "prior_version_ref": {"type": ["string", "null"]},
    "question_ref": {"type": "string", "minLength": 1},
    "question_version_ref": {"type": "string", "minLength": 1},
    "question_version_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "planner_ref": {"const": "planner:capital-lease-checklist:0.1"},
    "planner_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "template_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/template_binding"}},
    "required_coverage_items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "budget": {"$ref": "#/$defs/budget"},
    "doctrine_binding": {"type": "null"},
    "actor_ref": {"type": "string", "pattern": "^human:"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "template_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage_item_ref", "template_version_ref", "template_version_hash", "parameters"],
      "properties": {
        "coverage_item_ref": {"type": "string", "minLength": 1},
        "template_version_ref": {"type": "string", "minLength": 1},
        "template_version_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "parameters": {"type": "object", "additionalProperties": true}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_rounds", "max_cost_units", "max_seconds"],
      "properties": {
        "max_rounds": {"type": "integer", "minimum": 1},
        "max_cost_units": {"type": "integer", "minimum": 1},
        "max_seconds": {"type": "integer", "minimum": 1}
      }
    }
  }
}
