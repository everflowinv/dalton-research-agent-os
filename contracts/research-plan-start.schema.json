{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "ResearchPlanStart", "type": "object", "additionalProperties": false, "required": ["schema_version", "id", "created_at", "plan_version_ref", "plan_version_hash", "approval_ref", "approval_hash", "workflow_ref", "workflow_version_ref", "workflow_version_hash", "root_work_order_ref", "root_work_order_hash", "event_ref", "actor_ref", "content_hash"], "properties": {"schema_version": {"const": "0.1"}, "id": {"type": "string", "pattern": "^research-plan-start:[0-9a-f]{32}$"}, "created_at": {"type": "string", "format": "date-time"}, "plan_version_ref": {"type": "string", "pattern": "^research-plan:[0-9a-f]{32}$"}, "plan_version_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "approval_ref": {"type": "string", "pattern": "^research-plan-approval:[0-9a-f]{32}$"}, "approval_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "workflow_ref": {"type": "string", "pattern": "^workflow:research-plan:[0-9a-f]{32}$"}, "workflow_version_ref": {"type": "string", "pattern": "^workflow-version:research-plan:[0-9a-f]{32}$"}, "workflow_version_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "root_work_order_ref": {"type": "string", "pattern": "^work:plan-[0-9a-f]{32}$"}, "root_work_order_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "event_ref": {"type": "string", "pattern": "^research-plan-event:[0-9a-f]{32}$"}, "actor_ref": {"type": "string", "minLength": 1}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}