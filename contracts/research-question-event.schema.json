{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ResearchQuestionEvent","type":"object","additionalProperties":false,"required":["schema_version","id","created_at","question_ref","state","reason","metadata","actor_ref","content_hash"],"properties":{"schema_version":{"const":"0.1"},"id":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"question_ref":{"type":"string","pattern":"^research-question:[0-9a-f]{32}$"},"state":{"enum":["open","selected","planned","in_progress","answered","blocked","retired"]},"reason":{"type":"string","minLength":1},"metadata":{"type":"object"},"actor_ref":{"type":"string","minLength":1},"content_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
