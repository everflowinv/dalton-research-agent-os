{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalton.local/schemas/credential-use-receipt.schema.json",
  "title": "CredentialUseReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "created_at", "grant_ref", "grant_hash",
    "runner_request_ref", "runner_request_hash", "connector_invocation_ref",
    "connector_invocation_hash", "reservation_ref", "reservation_hash",
    "physical_attempt_number", "operation", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"$ref": "#/$defs/ref"},
    "created_at": {"type": "string", "format": "date-time"},
    "grant_ref": {"$ref": "#/$defs/ref"},
    "grant_hash": {"$ref": "#/$defs/hash"},
    "runner_request_ref": {"$ref": "#/$defs/ref"},
    "runner_request_hash": {"$ref": "#/$defs/hash"},
    "connector_invocation_ref": {"$ref": "#/$defs/ref"},
    "connector_invocation_hash": {"$ref": "#/$defs/hash"},
    "reservation_ref": {"$ref": "#/$defs/ref"},
    "reservation_hash": {"$ref": "#/$defs/hash"},
    "physical_attempt_number": {"type": "integer", "minimum": 1},
    "operation": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$"},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+._-]*:[A-Za-z0-9][A-Za-z0-9:._-]*$",
      "not": {"pattern": "^(file|path|https?):"}
    }
  }
}
