{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"ConnectorUsageEntry","type":"object","additionalProperties":false,
  "required":["schema_version","id","created_at","physical_attempt_ref","connector_invocation_ref","revision","correction_of_ref","measurement_status","metering_source","provider_usage_ref","metrics","content_hash"],
