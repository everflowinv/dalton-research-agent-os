{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"McpManagedTransportObservation",
  "type":"object",
  "additionalProperties":false,
  "required":["protocol_version","request_hash","outcome","provider_request_id","provider_status_code","retry_after_ms","structured_output","source_record_refs","cursor","provider_usage","source_status","completeness","error","content_hash"],
  "properties":{
    "protocol_version":{"const":"0.2"},"request_hash":{"$ref":"#/$defs/hash"},"outcome":{"enum":["succeeded","rate_limited","failed"]},
    "provider_request_id":{"type":["string","null"]},"provider_status_code":{"type":["integer","null"],"minimum":100,"maximum":599},"retry_after_ms":{"type":["integer","null"],"minimum":1},
    "structured_output":{"type":["object","null"]},"source_record_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"cursor":{"type":["string","null"]},"provider_usage":{"type":["object","null"]},
    "source_status":{"type":["string","null"],"enum":["complete","partial","empty",null]},"completeness":{"type":["string","null"],"enum":["enumerated","ranked","partial","unknown",null]},
    "error":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["code","message","retryable"],"properties":{"code":{"type":"string","minLength":1},"message":{"type":"string","minLength":1},"retryable":{"type":"boolean"}}}]},
    "content_hash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
