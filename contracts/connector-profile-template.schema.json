{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectorProfileTemplate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "created_at", "connector_ref", "source_identity",
    "transport", "auth_boundary", "route_restrictions", "schema_documents",
    "operations", "fixture_manifest_ref", "fixture_manifest_hash", "readiness",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "connector_ref": {"type": "string", "minLength": 1},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "source_type", "source_version"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["official_filing", "authenticated_library", "social_enumeration", "social_search", "public_web", "market_data"]},
        "source_version": {"type": "string", "minLength": 1}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_ref", "target_hash", "host_policy", "allowed_hosts"],
      "properties": {
        "kind": {"enum": ["public_https", "host_tool", "mcp_managed"]},
        "target_ref": {"type": "string", "minLength": 1},
        "target_hash": {"$ref": "#/$defs/hash"},
        "host_policy": {"enum": ["literal_allowlist", "per_call_authority", "not_applicable"]},
        "allowed_hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "auth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "owner", "credential_material", "use_time_authority"],
      "properties": {
        "mode": {"enum": ["none", "host_owned"]},
        "owner": {"enum": ["none", "host"]},
        "credential_material": {"const": "forbidden"},
        "use_time_authority": {"enum": ["none", "required_future"]}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "none"}}, "required": ["mode"]}, "then": {"properties": {"owner": {"const": "none"}, "use_time_authority": {"const": "none"}}}, "else": {"properties": {"owner": {"const": "host"}, "use_time_authority": {"const": "required_future"}}}}
      ]
    },
    "route_restrictions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_target_refs", "forbidden_target_refs", "fallback_routes", "provenance_label_required"],
      "properties": {
        "allowed_target_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_target_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fallback_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation", "target_ref", "source_ref", "adapter_ref", "provenance_label"],
            "properties": {
              "operation": {"type": "string", "minLength": 1},
              "target_ref": {"type": "string", "minLength": 1},
              "source_ref": {"type": "string", "minLength": 1},
              "adapter_ref": {"type": "string", "minLength": 1},
              "provenance_label": {"type": "string", "minLength": 1}
            }
          }
        },
        "provenance_label_required": {"const": true}
      }
    },
    "schema_documents": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_ref", "schema_hash", "document"],
        "properties": {
          "schema_ref": {"type": "string", "minLength": 1},
          "schema_hash": {"$ref": "#/$defs/hash"},
          "document": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "additionalProperties", "required", "properties"],
            "properties": {
              "type": {"const": "object"},
              "additionalProperties": {"const": false},
              "required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "properties": {"type": "object"}
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "source_method", "input_schema_ref", "input_schema_hash", "output_schema_ref", "output_schema_hash", "completeness_ceiling", "pagination", "side_effects"],
        "properties": {
          "operation": {"type": "string", "minLength": 1},
          "source_method": {"type": "string", "minLength": 1},
          "input_schema_ref": {"type": "string", "minLength": 1},
          "input_schema_hash": {"$ref": "#/$defs/hash"},
          "output_schema_ref": {"type": "string", "minLength": 1},
          "output_schema_hash": {"$ref": "#/$defs/hash"},
          "completeness_ceiling": {"enum": ["enumerated", "ranked", "partial", "unknown"]},
          "pagination": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "cursor_field", "bounded_window_required", "max_pages"],
            "properties": {
              "mode": {"enum": ["none", "cursor", "page"]},
              "cursor_field": {"type": ["string", "null"]},
              "bounded_window_required": {"type": "boolean"},
              "max_pages": {"type": "integer", "minimum": 1}
            }
          },
          "side_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "fixture_manifest_ref": {"type": "string", "minLength": 1},
    "fixture_manifest_hash": {"$ref": "#/$defs/hash"},
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "lease_eligible", "live_execution_allowed", "required_gate"],
      "properties": {
        "level": {"const": "inventory_connected"},
        "lease_eligible": {"const": false},
        "live_execution_allowed": {"const": false},
        "required_gate": {"type": "string", "minLength": 1}
      }
    },
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
