{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranscriptCorrectionSetVersion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "created_at",
    "correction_set_ref",
    "version",
    "prior_version_ref",
    "document_ref",
    "source_manifest_ref",
    "source_manifest_hash",
    "source_content_hash",
    "review_scope",
    "corrections",
    "accepted_count",
    "unresolved_count",
    "actor_ref",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {
      "type": "string",
      "pattern": "^transcript-correction-set-version:[0-9a-f]{32}$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "correction_set_ref": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "prior_version_ref": {"type": ["string", "null"]},
    "document_ref": {"type": "string", "pattern": "^alphaengine-doc:"},
    "source_manifest_ref": {"type": "string", "minLength": 1},
    "source_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_review": {
      "type": "object", "additionalProperties": false,
      "required": ["source_start", "source_end", "source_sha256", "rationale"],
      "properties": {
        "source_start": {"type": "integer", "minimum": 0},
        "source_end": {"type": "integer", "minimum": 1},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "review_scope": {"enum": ["targeted_flags", "full_document", "verified_raw_span", "automation_verified_raw_span"]},
    "corrections": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_start",
          "source_end",
          "source_sha256",
          "source_text",
          "correction_kind",
          "disposition",
          "replacement_text",
          "rationale",
          "evidence_bindings"
        ],
        "properties": {
          "source_start": {"type": "integer", "minimum": 0},
          "source_end": {"type": "integer", "minimum": 1},
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_text": {"type": "string", "minLength": 1},
          "correction_kind": {
            "enum": [
              "proper_name",
              "terminology",
              "numeric",
              "negation",
              "semantic",
              "speaker_label"
            ]
          },
          "disposition": {"enum": ["accepted", "unresolved"]},
          "replacement_text": {"type": ["string", "null"], "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "evidence_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "authority_ref",
                "authority_hash",
                "evidence_kind",
                "location"
              ],
              "properties": {
                "authority_ref": {"type": "string", "minLength": 1},
                "authority_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "evidence_kind": {
                  "enum": [
                    "audio_span",
                    "official_transcript_span",
                    "primary_reference"
                  ]
                },
                "location": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "accepted_count": {"type": "integer", "minimum": 0},
    "unresolved_count": {"type": "integer", "minimum": 0},
    "actor_ref": {
      "type": "string",
      "pattern": "^(human|automation):[A-Za-z0-9][A-Za-z0-9._/@:-]*$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [{"if": {"properties": {"review_scope": {"enum": ["verified_raw_span", "automation_verified_raw_span"]}}}, "then": {"required": ["raw_review"], "properties": {"corrections": {"maxItems": 0}}}, "else": {"not": {"required": ["raw_review"]}, "properties": {"corrections": {"minItems": 1}}}}, {"if": {"properties": {"review_scope": {"const": "automation_verified_raw_span"}}}, "then": {"properties": {"actor_ref": {"pattern": "^automation:"}}}, "else": {"properties": {"actor_ref": {"pattern": "^human:"}}}}]
}
