{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlphaEngineDocumentAcquisitionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "created_at", "document_ref", "document_id",
    "connector_profile_template_ref", "connector_profile_template_hash",
    "source_ref", "source_hash", "bridge_ref", "bridge_hash", "operation",
    "max_pages", "page_max_response_bytes", "max_total_response_bytes",
    "max_document_chars", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^alphaengine-document-plan:"},
    "created_at": {"type": "string", "format": "date-time"},
    "document_ref": {"type": "string", "pattern": "^alphaengine-doc:[A-Za-z0-9._-]{1,128}$"},
    "document_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "connector_profile_template_ref": {"type": "string", "minLength": 1},
    "connector_profile_template_hash": {"$ref": "#/$defs/hash"},
    "source_ref": {"const": "source:alphaengine"},
    "source_hash": {"$ref": "#/$defs/hash"},
    "bridge_ref": {"type": "string", "minLength": 1},
    "bridge_hash": {"$ref": "#/$defs/hash"},
    "operation": {"const": "get_document"},
    "max_pages": {"type": "integer", "minimum": 1, "maximum": 20},
    "page_max_response_bytes": {"type": "integer", "minimum": 1},
    "max_total_response_bytes": {"type": "integer", "minimum": 1},
    "max_document_chars": {"type": "integer", "minimum": 1},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
