{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundedPlannerTerminalEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "loop_version_ref", "loop_version_hash", "terminal_state", "proposal_ref", "proposal_hash", "formal_negative_claim_created", "actor_ref", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^bounded-planner-terminal-event:[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "loop_version_ref": {"type": "string", "minLength": 1},
    "loop_version_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminal_state": {"enum": ["coverage_complete_unobservable_candidate", "evidence_observed_for_review", "human_replan_required", "human_deprioritized", "budget_exhausted"]},
    "proposal_ref": {"type": ["string", "null"]},
    "proposal_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "formal_negative_claim_created": {"const": false},
    "actor_ref": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
