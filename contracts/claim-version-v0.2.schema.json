{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"dalton/claim-version/0.2",
  "title":"ClaimVersionV0.2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","id","created_at","claim_ref","version","subject_ref","metric_or_aspect","period","basis","normalized_statement","claim_kind","value","unit","currency","scale","producer_execution_refs","semantic_review_ref","semantic_review_hash","candidate_origin_ref","candidate_origin_hash","actor_ref","prior_version_ref","content_hash"],
  "properties":{
    "schema_version":{"const":"0.2"},"id":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"claim_ref":{"type":"string","minLength":1},"version":{"type":"integer","minimum":1},"subject_ref":{"type":"string","minLength":1},"metric_or_aspect":{"type":"string","minLength":1},"period":{"oneOf":[{"type":"string","minLength":1},{"type":"object"}]},"basis":{"type":"string","minLength":1},"normalized_statement":{"type":"string","minLength":1},"claim_kind":{"const":"quantitative"},"value":{"type":"string","pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},"unit":{"type":"string","minLength":1},"currency":{"anyOf":[{"type":"string","pattern":"^[A-Z]{3}$"},{"type":"null"}]},"scale":{"type":"string","minLength":1},"producer_execution_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"semantic_review_ref":{"type":"string","minLength":1},"semantic_review_hash":{"$ref":"#/$defs/hash"},"candidate_origin_ref":{"type":"string","minLength":1},"candidate_origin_hash":{"$ref":"#/$defs/hash"},"actor_ref":{"type":"string","pattern":"^human:tailscale-[0-9a-f]{32}$"},"prior_version_ref":{"type":["string","null"]},"content_hash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
