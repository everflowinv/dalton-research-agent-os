{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "ResearchPlanEvent", "type": "object", "additionalProperties": false, "required": ["schema_version", "id", "created_at", "plan_version_ref", "state", "reason", "metadata", "actor_ref", "content_hash"], "properties": {"schema_version": {"const": "0.1"}, "id": {"type": "string", "pattern": "^research-plan-event:[0-9a-f]{32}$"}, "created_at": {"type": "string", "format": "date-time"}, "plan_version_ref": {"type": "string", "pattern": "^research-plan:[0-9a-f]{32}$"}, "state": {"enum": ["created", "started"]}, "reason": {"type": "string", "minLength": 1}, "metadata": {"type": "object", "additionalProperties": true}, "actor_ref": {"type": "string", "minLength": 1}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}