{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoverageMissionSourceDiscovery",
  "description": "P9d-1 / P9d-4a: one completed search, bound to the exact Core connector invocation and source envelope it produced, the mission version and the discovery plan spec that authorized it. Append-only. Documents are partitioned into those Core already held and those newly discovered; the latter are queued for budgeted acquisition, never turned into Evidence or Claims here. AlphaEngine discoveries name alphaengine-doc: refs from search_library; web search discoveries name opaque public-web-url:sha256: refs derived from Gemini search_web citations (the page itself only enters authority through fetch_get).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "mission_version_ref", "mission_version_hash", "company_ref", "source_ref", "discovery_plan_ref", "discovery_plan_hash", "spec_ref", "query_hash", "parameters", "connector_invocation_ref", "connector_invocation_hash", "source_envelope_ref", "source_envelope_hash", "document_refs", "new_document_refs", "in_authority_document_refs", "actor_ref", "requested_by", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^mission-source-discovery:[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "mission_version_ref": {"type": "string", "pattern": "^coverage-mission-version:"},
    "mission_version_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "company_ref": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "enum": ["source:alphaengine", "source:web-search"]},
    "discovery_plan_ref": {"type": "string", "pattern": "^discovery-plan:"},
    "discovery_plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spec_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "query_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parameters": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["query", "filters", "cursor"],
          "properties": {
            "query": {"type": "string", "minLength": 1},
            "filters": {"type": "object"},
            "cursor": {"type": ["string", "null"]}
          }
        },
        {
          "additionalProperties": false,
          "required": ["query", "date_after", "date_before"],
          "properties": {
            "query": {"type": "string", "minLength": 1},
            "date_after": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "date_before": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          }
        }
      ]
    },
    "connector_invocation_ref": {"type": "string", "minLength": 1},
    "connector_invocation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_envelope_ref": {"type": "string", "minLength": 1},
    "source_envelope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "document_refs": {"type": "array", "items": {"type": "string", "pattern": "^(alphaengine-doc:|public-web-url:sha256:[0-9a-f]{64}$)"}, "uniqueItems": true},
    "new_document_refs": {"type": "array", "items": {"type": "string", "pattern": "^(alphaengine-doc:|public-web-url:sha256:[0-9a-f]{64}$)"}, "uniqueItems": true},
    "in_authority_document_refs": {"type": "array", "items": {"type": "string", "pattern": "^(alphaengine-doc:|public-web-url:sha256:[0-9a-f]{64}$)"}, "uniqueItems": true},
    "actor_ref": {"type": "string", "pattern": "^automation:"},
    "requested_by": {"type": "string", "pattern": "^(human|automation):"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"source_ref": {"const": "source:alphaengine"}}},
      "then": {
        "properties": {
          "parameters": {"required": ["filters", "cursor"]},
          "document_refs": {"items": {"pattern": "^alphaengine-doc:"}}
        }
      },
      "else": {
        "properties": {
          "parameters": {"required": ["date_after", "date_before"]},
          "document_refs": {"items": {"pattern": "^public-web-url:sha256:[0-9a-f]{64}$"}}
        }
      }
    }
  ]
}
