{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dalton/claim-version/0.1",
  "title": "ClaimVersion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "claim_ref", "version", "subject_ref", "metric_or_aspect", "period", "basis", "normalized_statement", "claim_kind", "value", "unit", "producer_invocation_refs", "actor_ref", "prior_version_ref", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"}, "id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1},
    "claim_ref": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "subject_ref": {"type": "string", "minLength": 1},
    "metric_or_aspect": {"type": "string", "minLength": 1}, "period": {"type": "string", "minLength": 1}, "basis": {"type": "string", "minLength": 1},
    "normalized_statement": {"type": "string", "minLength": 1}, "claim_kind": {"enum": ["quantitative", "qualitative"]},
    "value": {"type": ["number", "null"]}, "unit": {"type": ["string", "null"]},
    "producer_invocation_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "actor_ref": {"type": "string", "minLength": 1}, "prior_version_ref": {"type": ["string", "null"]}, "content_hash": {"type": "string", "minLength": 1}
  }
}
