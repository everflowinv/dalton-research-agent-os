{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dalton/authority-source-verification-material/0.2",
  "title": "AuthoritySourceVerificationMaterial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "created_at", "source_envelope_ref", "source_envelope_hash",
    "artifact_ref", "artifact_hash", "source_ref", "source_type", "operation", "provenance_mode",
    "authority_resolution_ref", "authority_resolution_hash", "source_record_refs", "next_cursor",
    "normalized_payload", "normalized_payload_hash", "source_schema_hash", "source_content_hash", "source_lineage",
    "published_at", "updated_at", "as_of", "retrieved_at", "completeness", "status", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_envelope_ref": {"type": "string", "minLength": 1},
    "source_envelope_hash": {"$ref": "#/$defs/hash"},
    "artifact_ref": {"type": "string", "minLength": 1},
    "artifact_hash": {"$ref": "#/$defs/hash"},
    "source_ref": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["official_filing", "authenticated_library", "social_enumeration", "social_search", "public_web", "market_data"]},
    "operation": {"type": "string", "minLength": 1},
    "provenance_mode": {"const": "connector_authority"},
    "authority_resolution_ref": {"type": "string", "minLength": 1},
    "authority_resolution_hash": {"$ref": "#/$defs/hash"},
    "source_record_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "next_cursor": {"type": ["string", "null"], "minLength": 1},
    "normalized_payload": {},
    "normalized_payload_hash": {"$ref": "#/$defs/hash"},
    "source_schema_hash": {"$ref": "#/$defs/hash"},
    "source_content_hash": {"$ref": "#/$defs/hash"},
    "source_lineage": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "as_of": {"type": ["string", "null"], "format": "date-time"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "completeness": {"enum": ["enumerated", "ranked", "partial", "unknown"]},
    "status": {"enum": ["complete", "partial", "empty", "error"]},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
