{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalton.local/schemas/price-rate-version.schema.json",
  "title": "PriceRateVersion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "price_rate_ref", "version", "provider", "model", "charge_type", "unit_quantity", "unit_price_micros", "currency", "effective_from", "effective_until", "source_ref", "actor_ref", "prior_version_ref", "content_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "price_rate_ref": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "charge_type": {"type": "string", "enum": ["input_tokens", "output_tokens", "reasoning_tokens", "cache_read_tokens", "cache_write_tokens", "request", "duration_ms", "input_bytes", "output_bytes", "custom"]},
    "unit_quantity": {"type": "integer", "minimum": 1},
    "unit_price_micros": {"type": "integer", "minimum": 0},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "effective_from": {"type": "string", "format": "date-time"},
    "effective_until": {"type": ["string", "null"], "format": "date-time"},
    "source_ref": {"type": "string", "minLength": 1},
    "actor_ref": {"type": "string", "minLength": 1},
    "prior_version_ref": {"type": ["string", "null"], "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
