{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"dalton/verification-bundle/0.1","title":"VerificationBundle","type":"object","additionalProperties":false,
  "required":["schema_version","id","created_at","kind","subject_ref","subject_hash","verdict","checkpoint_ref","checkpoint_hash","verifier_ref","verifier_hash","findings","content_hash"],
  "properties":{"schema_version":{"const":"0.1"},"id":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"},"kind":{"enum":["source","numeric"]},"subject_ref":{"type":"string","minLength":1},"subject_hash":{"$ref":"#/$defs/hash"},"verdict":{"enum":["pass","reject"]},"checkpoint_ref":{"type":"string","minLength":1},"checkpoint_hash":{"$ref":"#/$defs/hash"},"verifier_ref":{"type":"string","minLength":1},"verifier_hash":{"$ref":"#/$defs/hash"},"findings":{"type":"array","items":{"$ref":"#/$defs/finding"}},"content_hash":{"$ref":"#/$defs/hash"}},
  "$defs":{"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"finding":{"type":"object","additionalProperties":false,"required":["code","severity","status","path","expected","observed","message","content_hash"],"properties":{"code":{"type":"string","minLength":1},"severity":{"enum":["info","warning","error"]},"status":{"enum":["pass","fail"]},"path":{"type":"string","minLength":1},"expected":{"type":["string","null"]},"observed":{"type":["string","null"]},"message":{"type":"string","minLength":1},"content_hash":{"$ref":"#/$defs/hash"}}}}
}
