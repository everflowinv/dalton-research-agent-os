{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProbeTemplateVersion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "template_ref", "version", "prior_version_ref", "capability_ref", "operation", "runtime_profile_ref", "parameter_contract", "output_contract_ref", "verifier_ref", "permission_scope", "declared_side_effects", "cost", "side_effect_class", "actor_ref", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^probe-template-version:[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "template_ref": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "prior_version_ref": {"type": ["string", "null"]},
    "capability_ref": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "runtime_profile_ref": {"type": "string", "minLength": 1},
    "parameter_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_fields", "required_fields", "constants"],
      "properties": {
        "allowed_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "constants": {"type": "object", "additionalProperties": true}
      }
    },
    "output_contract_ref": {"type": "string", "minLength": 1},
    "verifier_ref": {"type": "string", "minLength": 1},
    "permission_scope": {"type": "string", "minLength": 1},
    "declared_side_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "cost": {
      "type": "object", "additionalProperties": false,
      "required": ["cost_units", "max_attempts", "max_seconds"],
      "properties": {
        "cost_units": {"type": "integer", "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1},
        "max_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "side_effect_class": {"const": "read_only"},
    "actor_ref": {"type": "string", "pattern": "^human:"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
