{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"ConnectorPhysicalAttempt","type":"object","additionalProperties":false,
  "required":["schema_version","id","created_at","connector_invocation_ref","reservation_ref","physical_attempt_number","outcome","started_at","completed_at","provider_request_id","retry_at","content_hash"],
