{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"dalton/human-review-decision/0.1",
  "title":"HumanReviewDecision",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","id","created_at","candidate_claim_ref","candidate_claim_hash","candidate_evidence_ref","candidate_evidence_hash","verdict","reviewed_semantics","proposed_revisions","relation","rationale","findings","reviewer_ref","authorization","source","source_event_ref","content_hash"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "id":{"type":"string","minLength":1},
    "created_at":{"type":"string","format":"date-time"},
    "candidate_claim_ref":{"type":"string","minLength":1},
    "candidate_claim_hash":{"$ref":"#/$defs/hash"},
    "candidate_evidence_ref":{"type":"string","minLength":1},
    "candidate_evidence_hash":{"$ref":"#/$defs/hash"},
    "verdict":{"enum":["accept","revise","reject"]},
    "reviewed_semantics":{"$ref":"#/$defs/semantics"},
    "proposed_revisions":{"type":["object","null"]},
    "relation":{"const":"supports"},
    "rationale":{"type":"string","minLength":1},
    "findings":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "reviewer_ref":{"type":"string","pattern":"^human:tailscale-[0-9a-f]{32}$"},
    "authorization":{"const":"explicit_human_review"},
    "source":{"const":"tailscale_review"},
    "source_event_ref":{"type":"string","pattern":"^research-review:"},
    "content_hash":{"$ref":"#/$defs/hash"}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "semantics":{"type":"object","additionalProperties":false,"required":["subject_ref","metric_or_aspect","period","basis","normalized_statement"],"properties":{"subject_ref":{"type":"string","minLength":1},"metric_or_aspect":{"type":"string","minLength":1},"period":{"oneOf":[{"type":"string","minLength":1},{"type":"object"}]},"basis":{"type":"string","minLength":1},"normalized_statement":{"type":"string","minLength":1}}}
  }
}
