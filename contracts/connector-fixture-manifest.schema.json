{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectorFixtureManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "connector_template_ref", "recording_boundary", "authenticated", "synthetic", "operations", "cases", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "connector_template_ref": {"type": "string", "minLength": 1},
    "recording_boundary": {"enum": ["public_provider", "host_gateway"]},
    "authenticated": {"type": "boolean"},
    "synthetic": {"const": true},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "pagination_mode"],
        "properties": {
          "operation": {"type": "string", "minLength": 1},
          "pagination_mode": {"enum": ["none", "cursor", "page"]}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_ref", "scenario", "operation", "outcome", "provider_status", "source_status", "completeness", "page", "next_cursor", "source_record_refs", "raw_payload_hash", "error_code"],
        "properties": {
          "case_ref": {"type": "string", "minLength": 1},
          "scenario": {"enum": ["success", "empty", "pagination", "partial", "schema_drift", "rate_limited", "timeout", "malformed", "permission_denied", "revoked"]},
          "operation": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["succeeded", "rate_limited", "timeout", "failed"]},
          "provider_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
          "source_status": {"enum": ["complete", "partial", "empty", "error", null]},
          "completeness": {"enum": ["enumerated", "ranked", "partial", "unknown", null]},
          "page": {"type": ["integer", "null"], "minimum": 1},
          "next_cursor": {"type": ["string", "null"]},
          "source_record_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "raw_payload_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
          "error_code": {"type": ["string", "null"]}
        }
      }
    },
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
