{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchPlanStageOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "created_at",
    "plan_version_ref",
    "plan_version_hash",
    "step_ref",
    "step_hash",
    "stage",
    "operation",
    "output_contract_ref",
    "upstream_work_order_ref",
    "upstream_result_ref",
    "upstream_result_hash",
    "records",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^research-plan-stage-output:[0-9a-f]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "plan_version_ref": {"type": "string", "pattern": "^research-plan:[0-9a-f]{32}$"},
    "plan_version_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "step_ref": {"type": "string", "pattern": "^research-plan-step:[a-z_]+:[0-9a-f]{32}$"},
    "step_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stage": {
      "enum": ["authority_resolver", "verifier", "candidate_staging"]
    },
    "operation": {"type": "string", "minLength": 1},
    "output_contract_ref": {"type": "string", "minLength": 1},
    "upstream_work_order_ref": {"type": "string", "pattern": "^work:plan-[0-9a-f]{32}$"},
    "upstream_result_ref": {"type": "string", "minLength": 1},
    "upstream_result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "hash"],
        "properties": {
          "kind": {
            "enum": [
              "authority_resolution",
              "source_verification",
              "numeric_verification",
              "candidate_evidence",
              "candidate_claim"
            ]
          },
          "ref": {"type": "string", "minLength": 1},
          "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
