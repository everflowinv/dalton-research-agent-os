{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dalton/adjudication-version/0.1",
  "title": "AdjudicationVersion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "claim_ref", "claim_version_ref", "version", "adjudicated_status", "rationale", "findings", "adjudicator_invocation_ref", "subject_invocation_refs", "independence_policy_ref", "prior_version_ref", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"}, "id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1},
    "claim_ref": {"type": "string", "minLength": 1}, "claim_version_ref": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}, "adjudicated_status": {"enum": ["corroborated", "contested", "superseded", "retracted"]},
    "rationale": {"type": "string", "minLength": 1}, "findings": {"type": "array", "items": {"type": "object"}},
    "adjudicator_invocation_ref": {"type": "string", "minLength": 1}, "subject_invocation_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "independence_policy_ref": {"type": "string", "minLength": 1}, "prior_version_ref": {"type": ["string", "null"]}, "content_hash": {"type": "string", "minLength": 1}
  }
}
