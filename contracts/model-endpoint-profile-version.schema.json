{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalton.local/schemas/model-endpoint-profile-version.schema.json",
  "title": "ModelEndpointProfileVersion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "profile_version_ref", "version", "created_at",
    "prior_version_ref", "provider", "model", "family", "adapter_ref",
    "credential_slot_ref", "capabilities", "modalities", "context", "availability",
    "cost", "limits", "content_hash"
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+._-]*:[^\\s]+$"},
    "token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+\\-]*$"},
    "tokens": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/token"}
    }
  },
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"$ref": "#/$defs/ref"},
    "profile_version_ref": {"$ref": "#/$defs/ref"},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "prior_version_ref": {
      "oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]
    },
    "provider": {"$ref": "#/$defs/token"},
    "model": {"$ref": "#/$defs/token"},
    "family": {"$ref": "#/$defs/token"},
    "adapter_ref": {"$ref": "#/$defs/ref"},
    "credential_slot_ref": {
      "type": "string",
      "pattern": "^credential[-_]slot:[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "capabilities": {"$ref": "#/$defs/tokens"},
    "modalities": {"$ref": "#/$defs/tokens"},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["max_context_tokens", "max_output_tokens"],
      "properties": {
        "max_context_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "availability": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "checked_at", "valid_until"],
      "properties": {
        "state": {"enum": ["available", "degraded", "unavailable"]},
        "checked_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"}
      }
    },
    "cost": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "input_per_million_usd", "output_per_million_usd"],
      "properties": {
        "currency": {"const": "USD"},
        "input_per_million_usd": {"type": "number", "minimum": 0},
        "output_per_million_usd": {"type": "number", "minimum": 0}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_input_tokens", "max_output_tokens", "max_total_tokens", "max_cost_usd"],
      "properties": {
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_total_tokens": {"type": "integer", "minimum": 1},
        "max_cost_usd": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "content_hash": {"$ref": "#/$defs/hash"}
  }
}
