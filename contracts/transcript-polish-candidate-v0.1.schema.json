{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranscriptPolishCandidateV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "segments"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_start", "source_end", "source_sha256", "polished_text"],
        "properties": {
          "source_start": {"type": "integer", "minimum": 0},
          "source_end": {"type": "integer", "minimum": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "polished_text": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
