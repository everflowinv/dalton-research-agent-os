{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dalton/evidence-version/0.1",
  "title": "EvidenceVersion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "evidence_ref", "version", "source_type", "source_ref", "retrieved_at", "valid_until", "artifact_refs", "source_lineage", "independence_group", "actor_ref", "prior_version_ref", "content_hash"],
  "properties": {
    "schema_version": {"const": "0.1"}, "id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1},
    "evidence_ref": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1},
    "source_type": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}, "retrieved_at": {"type": "string", "minLength": 1},
    "valid_until": {"type": ["string", "null"]}, "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_lineage": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "independence_group": {"type": "string", "minLength": 1},
    "actor_ref": {"type": "string", "minLength": 1}, "prior_version_ref": {"type": ["string", "null"]}, "content_hash": {"type": "string", "minLength": 1}
  }
}
