{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalton.local/schemas/work-order-link.schema.json",
  "title": "WorkOrderLink",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "created_at", "workflow_ref", "parent_work_order_ref", "child_work_order_ref", "relation", "sequence", "actor_ref", "content_hash"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "workflow_ref": {"type": "string", "minLength": 1},
    "parent_work_order_ref": {"type": "string", "minLength": 1},
    "child_work_order_ref": {"type": "string", "minLength": 1},
    "relation": {"type": "string", "enum": ["decomposed_from", "verifies", "follows_up"]},
    "sequence": {"type": "integer", "minimum": 0},
    "actor_ref": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
