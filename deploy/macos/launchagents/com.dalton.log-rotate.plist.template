<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  每天 04:10 轮转一次 ~/Library/Logs/Dalton/*.log。

  为什么不用 newsyslog：/etc/newsyslog.d 需要 root，而 Dalton 全套是用户级
  LaunchAgent，装一个需要 sudo 的组件就意味着以后每次安装都要 sudo。
  为什么不在各服务入口用 RotatingFileHandler 接管 stderr：日志是 launchd 通过
  StandardErrorPath 重定向的 fd，Python 层的 handler 管不到子进程和解释器本身
  写到 fd 2 的东西（traceback、C 扩展的输出），会漏掉最需要留下的那部分。

  占位符：
    @@RELEASE_VENV@@  形如 ~/.dalton/runtime/releases/<sha>/venv
    @@REPO@@          仓库根目录（rotate_dalton_logs.py 所在处的上一级）
    @@LOG_DIR@@       形如 ~/Library/Logs/Dalton
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.dalton.log-rotate</string>
	<key>ProgramArguments</key>
	<array>
		<string>@@RELEASE_VENV@@/bin/python</string>
		<string>@@REPO@@/scripts/rotate_dalton_logs.py</string>
		<string>--log-dir</string>
		<string>@@LOG_DIR@@</string>
		<string>--max-bytes</string>
		<string>16777216</string>
		<string>--keep</string>
		<string>5</string>
		<string>apply</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>10</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@@LOG_DIR@@/log-rotate.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>@@LOG_DIR@@/log-rotate.stderr.log</string>
</dict>
</plist>
