{
  "$id": "https://dalton.local/schemas/earnings-verifier-provider-output-v0.1.schema.json",
  "title": "EarningsVerifierProviderOutputV0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "findings"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "pass",
        "reject"
      ]
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "enum": [
              "unsupported_claim",
              "missing_caveat",
              "wrong_period",
              "invented_number",
              "ok"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
