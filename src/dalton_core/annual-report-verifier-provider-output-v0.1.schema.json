{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "verified_statement",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "verdict": {
      "enum": [
        "pass",
        "reject"
      ]
    },
    "verified_statement": {
      "type": [
        "string",
        "null"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
